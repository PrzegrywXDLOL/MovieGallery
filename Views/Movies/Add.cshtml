@model MovieGallery.Models.Movie
@{
    ViewData["Title"] = "Add Movie";
}
<h1 style="justify-self:center;">@ViewData["Title"]</h1>
<hr />

<div class="row">
    <div class="col-md-6 align-content-center">
        <form asp-action="Add" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.AntiForgeryToken()
            <div class="row" style="margin-bottom:2.5vh">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Title" class="control-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Director" class="control-label"></label>
                        <input asp-for="Director" class="form-control" />
                        <span asp-validation-for="Director" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="Cast" class="control-label"></label>
                        <input asp-for="Cast" class="form-control" />
                        <span asp-validation-for="Cast" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ReleaseDate" class="control-label">Release Date</label>
                        <input type="date" asp-for="ReleaseDate" class="form-control" />
                        <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-8">
                    <label asp-for="Poster" class="control-label"></label>
                    <div class="form-group" style="display:flex">
                        <input id="PosterFileInput" type="file" asp-for="Poster" class="form-control" accept=".jpg,.jpeg,image/jpeg" onchange="previewImage(event)"/>
                        <button type="button" class="btn btn-primary" onclick="clearPosterSelection()">⌫</button>
                        <span asp-validation-for="Poster" class="text-danger"></span> 
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Genre" class="control-label">Genre</label>
                        <select asp-for="Genre" name="Genre" class="form-control" multiple size="8">
                            @if (ViewBag.Genre != null)
                            {
                                foreach (var genre in ViewBag.Genre)
                                {
                                    <option value="@genre">@genre</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Genre" class="text-danger"></span>
                        <span style="font-size:0.8rem;">Press Ctrl (Cmd) to choose more</span> 
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Description" class="control-label"></label>
                        <textarea asp-for="Description" class="form-control" maxlength="250" oninput="updateCount(this)" style="height:20vh"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                        <small class="form-text text-muted">
                            <span id="charCount">0</span> / 250
                        </small>
                    </div>
                </div>
                <div class="form-group text-center">
                    <input type="submit" value="Add Movie" class="btn btn-primary btn-lg" style="width: 200px;" />
                </div>
            </div>
        </form>
    </div>
    <div class="col-md-6 d-flex justify-content-center" >
        <div>
            <h2 style="justify-self:center;">Poster preview</h2>
            <div id="posterPreview" style="display: flex; align-items: center; justify-content: center; min-width:40.5vh;
                                            max-width:40.5vh; max-height:60vh; min-height:60vh;">
                <img id="previewImage" src="~/Img/Placeholder.jpg" alt="Poster preview" class="img-fluid" style="object-fit: fill; width:100%;
                                                                                     border: 1px solid white; border-radius: 4px; aspect-ratio: 27 / 40;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

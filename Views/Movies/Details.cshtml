@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@model MovieGallery.Models.MovieDetailsViewModel
@{
    ViewData["Title"] = "Movie Details";
}
<h1 style="justify-self:center; text-align:center;">@Model.Movie.Title</h1>
<hr />

<div class="row">
    <div class="col-md-6 d-flex flex-column align-items-center">
        <div id="posterPreview" style="display: flex; min-width:40.5vh; max-width:40.5vh; max-height:60vh; min-height:60vh; margin-bottom:2.5vh">
            <img src="@Url.Action("GetPoster", "Movies", new { id = @Model.Movie.Id })" alt="Poster" class="img-fluid" style="object-fit: fill; width:100%;
                                                border: 1px solid white; border-radius: 4px; aspect-ratio: 27 / 40;" />
        </div>
        @* @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
        { *@
            <a class="btn btn-primary btn-lg" asp-area="" asp-action="Edit" asp-route-id="@Model.Movie.Id" style="margin-bottom:2.5vh;">Edit Movie Details</a>
        @* } *@
    </div>
    <div class="col-md-6 justify-content-center">
        <h2 style="justify-self:center;">Movie Details</h2>
        <div class="row">
            <div class="col-md-4">
                <h4>Director:</h4>
                <p>@Model.Movie.Director</p>
            </div>
            <div class="col-md-4">
                <h4>Genre:</h4>
                <p>@Model.Movie.Genre</p>
            </div>
            <div class="col-md-4">
                <h4>Release Date:</h4>
                <p>@Model.Movie.ReleaseDate.ToString("dd-MM-yyyy")</p>
            </div>
            <div class="col-md-12">
                <h4>Cast:</h4>
                <p>@Model.Movie.Cast</p>
            </div>
            <h4>Description:</h4>
            <p>@Model.Movie.Description</p>
            <div class="text-center">
                <h3>Reviews:</h3>
                <div class="review-container d-flex justify-content-center align-items-center">
                    @if (@Model.Reviews.Count() > 0)
                    {
                        @foreach (var review in Model.Reviews)
                        {
                            <p>@review.ReviewerName</p>
                            <p>@review.Content</p>
                            <p>@review.Rating</p>
                        }
                    }
                    else
                    {
                        <h3>No reviews for this movie</h3>
                    }
                </div>
                @if (SignInManager.IsSignedIn(User))
                {
                    <a class="btn btn-primary btn-lg" asp-action="Review" asp-route-id="@Model.Movie.Id" style="margin-bottom:2.5vh;">Add Movie Review</a>
                }
                else
                {
                    <a class="btn btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Details", "Movies", new { id = Model.Movie.Id })" style="margin-bottom:2.5vh;">Login to add review</a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

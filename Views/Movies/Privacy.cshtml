@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="privacy-page">
    <header class="privacy-hero">
        <span class="privacy-eyebrow">MovieGallery</span>
        <h1>Privacy Policy</h1>
        <p>
            This policy explains what information MovieGallery uses and how it is
            handled when you use the website.
        </p>
    </header>

    <div class="privacy-content">
        <section class="privacy-card">
            <h2>Information we use</h2>
            <p>
                When you create an account, the application processes account
                information such as your username and email address. If you post a
                review, the review content, rating and reviewer name are also
                processed.
            </p>
        </section>

        <section class="privacy-card">
            <h2>How information is used</h2>
            <p>
                Information is used to provide account access, display movie
                reviews, administer the website and operate its features.
            </p>
        </section>

        <section class="privacy-card">
            <h2>AI assistant</h2>
            <p>
                If you use the AI assistant, your prompt and movie catalogue
                information may be sent to Google Gemini to generate a response.
                Do not include passwords, sensitive personal information or other
                confidential data in your prompts. The provider handles submitted
                information under its own privacy terms.
            </p>
        </section>

        <section class="privacy-card">
            <h2>Cookies and browser storage</h2>
            <p>
                The website uses authentication cookies to support sign-in.
                If chat history is enabled, chat messages may be stored in your
                browser session storage so they remain available while navigating
                the website in the same browser session.
            </p>
        </section>

        <section class="privacy-card">
            <h2>Data retention and security</h2>
            <p>
                Account and review information is retained while needed to operate
                the website or meet applicable requirements. Reasonable measures
                are used to protect stored information; no online service can
                guarantee absolute security.
            </p>
        </section>

        <section class="privacy-card">
            <h2>Your choices</h2>
            <p>
                You can stop using the website at any time. For questions about
                your account information or privacy, contact the website
                administrator.
            </p>
        </section>
    </div>
</section>
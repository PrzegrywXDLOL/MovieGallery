@model MovieGallery.Models.Review
@{
    ViewData["Title"] = "Add Review";
}
<h1 style="justify-self:center;">@ViewData["Title"]</h1>
<hr />
<div class="row">
    <div class="col-md-6 d-flex flex-column align-items-center">
        <div id="posterPreview" style="display: flex; min-width:40.5vh; max-width:40.5vh; max-height:60vh; min-height:60vh; margin-bottom:2.5vh">
            <img src="@Url.Action("GetPoster", "Movies", new { id = @Model.MovieId })" alt="Poster" class="img-fluid" style="object-fit: fill; width:100%;
                                                border: 1px solid white; border-radius: 4px; aspect-ratio: 27 / 40;" />
        </div>
    </div>
    <div class="col-md-6 d-flex flex-column justify-content-center">
        <form asp-action="Review" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.AntiForgeryToken()
            <div class="form-group">
                <h3 class="text-center">Your Review</h3>
                <textarea asp-for="Content" class="form-control" maxlength="350" oninput="updateCount(this)" style="height: 20vh; width: 100%;"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
                <small class="form-text text-muted">
                    <span id="charCount">0</span> / 350
                </small>
            </div>
            <div class="form-group">
                <h3 class="text-center">Movie Rating</h3>
                <div class="rating">
                    <input type="hidden" asp-for="Rating" id="rating-value"/>
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="star" data-value="@i">&#9734;</span>
                    }
                </div>
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="Id" value="0" /> @* Had to add this line because somehow review had Id = 1 in POST *@
            <input type="hidden" asp-for="MovieId" />
            <div class="form-group text-center" style="margin-top: 2vh;">
                <input type="submit" value="Add Review" class="btn btn-primary btn-lg" style="width: 200px;" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
